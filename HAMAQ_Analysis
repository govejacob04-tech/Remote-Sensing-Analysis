            ax_ts_pm.plot(full_day_hours_local, vals, marker='s', ls='--', color=aqs_color_dict.get(stat, 'gray'), lw=lw_val, alpha=0.85, zorder=10, label=f"{stat}")
    if city_choice == "2" and aqs_pm25_ts_data_24h:
