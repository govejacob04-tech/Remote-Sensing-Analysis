    ax_ts_pm.xaxis.set_major_locator(mdates.HourLocator(interval=2))  

    for ax_obj in [ax_ts_success, ax_ts_combined, ax_ts_o3, ax_ts_pm]: ax_obj.tick_params(axis='y', labelsize=19)
    for ax_obj in [ax_ts_success, ax_ts_o3]: ax_obj.tick_params(axis='x', labelbottom=False)
    ax_ts_combined.tick_params(axis='x', labelsize=19)
    ax_ts_pm.tick_params(axis='x', labelsize=19)

    for ax_wv, sat in [(ax_wv_terra, 'Terra'), (ax_wv_aqua, 'Aqua')]:
        ax_wv.set_extent([min_lon, max_lon, min_lat, max_lat], crs=data_crs)
        if sat in worldview_images:
            img = mpimg.imread(worldview_images[sat])
            ax_wv.imshow(img, origin='upper', extent=[min_lon, max_lon, min_lat, max_lat], transform=data_crs)
        ax_wv.add_feature(cfeature.COASTLINE, edgecolor='white', zorder=5)
        ax_wv.add_feature(cfeature.STATES, edgecolor='white', linestyle='-', zorder=5)
        ax_wv.add_geometries(main_roads, crs=data_crs, edgecolor='yellow', linewidth=1, facecolor='none', alpha=0.8, zorder=6)
        ax_wv.add_geometries([gcas_poly], crs=data_crs, edgecolor='white', linewidth=2, facecolor='none', zorder=7)
        sat_time = exact_overpass_times.get(sat, "~10:30 AM Local" if sat == 'Terra' else "~01:30 PM Local")
        ax_wv.set_title(f"{sat} Overpass: {sat_time}", fontsize=24, fontweight='bold', y=-0.15)
        ax_wv.axis('off')

    x_vals_list, y_vals_list = [], []
    if not master_stations.empty:
        for st in tempo_ts_data.keys():
            for p_val, t_val in zip(pandora_ts_data[st], tempo_ts_data[st]):
                if not np.isnan(p_val) and not np.isnan(t_val):
                    x_vals_list.append(p_val); y_vals_list.append(t_val)
    x_val, y_val = np.array(x_vals_list), np.array(y_vals_list)

    if len(x_val) > 1 and len(y_val) > 1:
        pearson_r, mean_bias, rmse = np.corrcoef(x_val, y_val)[0, 1], np.mean(y_val - x_val), np.sqrt(np.mean((y_val - x_val)**2))
        ax_scatter.scatter(x_val, y_val, alpha=0.7, edgecolors='k', color='crimson', label='Matched Data')
        max_limit, min_limit = max(max(x_val), max(y_val)) * 1.1, min(min(x_val), min(y_val)) * 0.9
        ax_scatter.plot([min_limit, max_limit], [min_limit, max_limit], 'k--', alpha=0.7, label='1:1 Line')
        ax_scatter.text(0.05, 0.95, f"$r^2$ = {pearson_r**2:.3f}\nMean Bias = {mean_bias:.2e}\nRMSE = {rmse:.2e}", transform=ax_scatter.transAxes, fontsize=12, va='top', bbox=dict(boxstyle='round,pad=0.5', facecolor='white', alpha=0.8))
        ax_scatter.set_xlim([min_limit, max_limit]); ax_scatter.set_ylim([min_limit, max_limit])
        ax_scatter.set_xlabel('Pandora total $\\text{NO}_2$ [molecules/cm$^2$]', fontsize=14)
        ax_scatter.set_ylabel('TEMPO total $\\text{NO}_2$ [molecules/cm$^2$]', fontsize=14)
        ax_scatter.set_title('TEMPO vs. Pandora', fontsize=20, fontweight='bold')
        ax_scatter.tick_params(axis='both', labelsize=12)
        ax_scatter.grid(True, linestyle=':', alpha=0.6)
        ax_scatter.legend(loc='lower right', fontsize=11)
    else:
        ax_scatter.text(0.5, 0.5, "Insufficient\nMatched Data", ha='center', va='center', fontsize=16)
        ax_scatter.axis('off')

    sm = plt.cm.ScalarMappable(cmap='YlOrRd', norm=plt.Normalize(vmin=VMIN, vmax=VMAX))
    cbar = fig.colorbar(sm, cax=cbar_ax, orientation='horizontal')
    cbar.set_label('TEMPO Tropospheric NO$_2$ [molec/cm$^2$]', fontsize=20, fontweight='bold')

    plot_filename = os.path.join(save_dir, f"{city_name}_Full_Dashboard_{target_date_str}.png")
    fig.savefig(plot_filename, dpi=300, bbox_inches='tight')
    print(f"Dashboard saved: {plot_filename}")

    # Export
    if master_map_data:
        map_df = pd.concat(master_map_data, ignore_index=True)
        map_csv_path = os.path.join(csv_dir, f"{city_name}_MapGrid_Success_{target_date_str}.csv")
        map_df.to_csv(map_csv_path, index=False)

    csv_rows = []
    for i, current_time in enumerate(times):
        current_cf = mean_cf_list[i] if pd.notna(mean_cf_list[i]) else 1.0
        success_flag = 1 if current_cf <= CLOUD_THRESHOLD else 0
        yield_pct = round((valid_l3_list[i] / total_l3_list[i]) * 100.0, 2) if total_l3_list[i] > 0 else 0.0
        local_time_str = times_local[i].strftime('%Y-%m-%d %I:%M %p')
        row = {
            'Time_UTC': current_time.strftime('%Y-%m-%d %H:%M:%S'), 
            'Time_Local': local_time_str,
            'Hour_Local': times_local[i].hour,
            'Date': current_time.strftime('%Y-%m-%d'),
            'domain_cloud_frac': mean_cf_list[i], 'Data_Success_Flag': success_flag, 'Valid_Pixel_Yield_Pct': yield_pct,
            'Domain_Total_Expected_L3_Cells': total_l3_list[i], 'Domain_Valid_L3_Cells': valid_l3_list[i]
        }
        if not master_stations.empty:
            for st in tempo_ts_data.keys():
                clean_st_name = st.split('(')[0].strip() 
                row[f'Pandora_NO2_{clean_st_name}'] = pandora_ts_data[st][i]
                row[f'TEMPO_Total_NO2_5km_{clean_st_name}'] = tempo_ts_data[st][i]
        for site in target_aqs_sites:
            row[f'Surface_O3_{site}'] = aqs_o3_ts_data_12h[site][i]
            row[f'Surface_PM25_{site}'] = aqs_pm25_ts_data_12h[site][i]
        csv_rows.append(row)

    csv_df = pd.DataFrame(csv_rows)
    csv_filename = os.path.join(csv_dir, f"{city_name}_Time_Series_Data_{target_date_str}.csv")
    csv_df.to_csv(csv_filename, index=False)
    print(f"CSV data saved: {csv_filename}")
    
    plt.close(fig)

print("\nMonthly processing complete.")
