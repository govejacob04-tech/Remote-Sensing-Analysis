def process_single_file(file_obj, target_vars, dl_start, min_lat, max_lat, min_lon, max_lon):
    try:
        ds_root = xr.open_dataset(file_obj, engine='h5netcdf')
        try: ds_prod = xr.open_dataset(file_obj, engine='h5netcdf', group='product')
        except: ds_prod = ds_root
        try: ds_supp = xr.open_dataset(file_obj, engine='h5netcdf', group='support_data')
        except: ds_supp = ds_root

        lat_name = 'latitude' if 'latitude' in ds_root.variables else 'lat'
        lon_name = 'longitude' if 'longitude' in ds_root.variables else 'lon'
        
        lat_vals = np.squeeze(ds_root[lat_name].values)
        lon_vals = np.squeeze(ds_root[lon_name].values)
        if lat_vals.ndim == 1 and lon_vals.ndim == 1:
            lon_vals, lat_vals = np.meshgrid(lon_vals, lat_vals)
        lon_vals = np.where(lon_vals > 180, lon_vals - 360, lon_vals)
        
        mask = (lat_vals >= min_lat) & (lat_vals <= max_lat) & (lon_vals >= min_lon) & (lon_vals <= max_lon)
        if not np.any(mask):
            ds_root.close()
            if ds_prod is not ds_root: ds_prod.close()
            if ds_supp is not ds_root: ds_supp.close()
            return pd.DataFrame()
        
        data_dict = {'lat': lat_vals[mask], 'lon': lon_vals[mask]}
        time_val = dl_start
        filename = os.path.basename(file_obj)
        
        match = re.search(r'_(202\d{5}T\d{6}Z)', filename)
        if match:
            time_val = pd.to_datetime(match.group(1), format="%Y%m%dT%H%M%SZ")
            
        data_dict['time'] = time_val
        
        for nc_var, df_col_name in target_vars.items():
            if nc_var in ds_prod.variables:
                vals = np.squeeze(ds_prod[nc_var].values)
            elif nc_var in ds_supp.variables:
                vals = np.squeeze(ds_supp[nc_var].values)
            elif nc_var in ds_root.variables:
                vals = np.squeeze(ds_root[nc_var].values)
            else:
                continue
                
            masked_vals = vals[mask]
            masked_vals = np.where(masked_vals < -900, np.nan, masked_vals)
            data_dict[df_col_name] = masked_vals
        
        df = pd.DataFrame(data_dict)
        cols_present = [v for v in target_vars.values() if v in df.columns]
        if cols_present:
            df = df.dropna(subset=cols_present, how='all')
        
        ds_root.close()
        if ds_prod is not ds_root: ds_prod.close()
        if ds_supp is not ds_root: ds_supp.close()
        return df
    except Exception as e:
        return pd.DataFrame()

def fetch_local_earthdata_product(directory, product_prefix, target_date_str, target_vars, dl_start, min_lat, max_lat, min_lon, max_lon):
    target_date_compact = target_date_str.replace("-", "")
    local_files = []
    for root, dirs, files in os.walk(directory):
        for f in files:
            if f.endswith(('.nc', '.h5', '.nc4')) and target_date_compact in f and product_prefix in f:
                local_files.append(os.path.join(root, f))
    
    if not local_files:
        return pd.DataFrame()

    df_list = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        futures = [executor.submit(process_single_file, f_obj, target_vars, dl_start, min_lat, max_lat, min_lon, max_lon) for f_obj in local_files]
        for future in concurrent.futures.as_completed(futures):
            df = future.result()
            if not df.empty: df_list.append(df)
            
    if df_list:
        combined_df = pd.concat(df_list)
        return standardize_index(combined_df)
    return pd.DataFrame()

def get_exact_overpass_time(sat, target_date_str, bbox_tuple, local_timezone):
    short_name = "MOD04_L2" if sat == 'Terra' else "MYD04_L2"
    try:
        results = earthaccess.search_data(
            short_name=short_name,
            bounding_box=bbox_tuple,
            temporal=(f"{target_date_str}T00:00:00", f"{target_date_str}T23:59:59"),
            count=1
        )
        if results:
            dt_str = results[0]['umm']['TemporalExtents'][0]['RangeDateTimes'][0]['BeginningDateTime']
            dt_utc = pd.to_datetime(dt_str)
            dt_local = dt_utc.tz_convert(local_timezone)
            return dt_local.strftime('%I:%M %p Local')
    except Exception:
        pass
    return "~10:30 AM Local" if sat == 'Terra' else "~01:30 PM Local"

