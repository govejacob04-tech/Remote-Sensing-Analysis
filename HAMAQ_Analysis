            if not valid_p.empty: ax.scatter(valid_p['lon'], valid_p['lat'], c=valid_p[pandoracol], cmap='YlOrRd', s=200, edgecolors='white', linewidths=2.5, vmin=VMIN, vmax=VMAX, transform=data_crs, zorder=8)

