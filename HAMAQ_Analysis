def load_simat_csv(filepath, target_date):
    try:
        df = pd.read_csv(filepath, sep=None, engine='python', skiprows=9) 
    except Exception as e:
        return pd.DataFrame(), pd.DataFrame()

    df.columns = [str(c).lower().strip() for c in df.columns]
    if 'value' in df.columns and 'valor' not in df.columns:
        df = df.rename(columns={'value': 'valor'})
    
    local_tz_mx = pytz.timezone("America/Mexico_City")
    df['date'] = pd.to_datetime(df['date'], errors='coerce')
    df = df.dropna(subset=['date'])
    df['date'] = df['date'].dt.tz_localize(local_tz_mx, ambiguous='NaT', nonexistent='shift_forward').dt.tz_convert('UTC').dt.tz_localize(None)
    
    if 'valor' in df.columns:
        df['valor'] = pd.to_numeric(df['valor'], errors='coerce')
    if 'id_parameter' in df.columns:
        df['id_parameter'] = df['id_parameter'].astype(str).str.strip()
    
    local_start = local_tz_mx.localize(pd.to_datetime(target_date))
    utc_start = local_start.astimezone(pytz.UTC).replace(tzinfo=None)
    utc_end = utc_start + timedelta(hours=23, minutes=59, seconds=59)
    
    df = df[(df['date'] >= utc_start) & (df['date'] <= utc_end)]
    df['lat'] = df['id_station'].map(lambda x: simat_stations.get(x, {}).get('lat', np.nan))
    df['lon'] = df['id_station'].map(lambda x: simat_stations.get(x, {}).get('lon', np.nan))
    df = df.dropna(subset=['lat', 'lon', 'valor'])
    df = df.rename(columns={'date': 'time', 'id_station': 'STATION'})
    
    df_o3 = df[df['id_parameter'] == 'O3'].copy().rename(columns={'valor': 'ozone'})
    df_pm25 = df[df['id_parameter'] == 'PM2.5'].copy().rename(columns={'valor': 'pm25'})
    return df_o3, df_pm25

def fetch_with_retries(rsig_instance, data_key, max_retries=3):
    for attempt in range(max_retries):
        try:
            return rsig_instance.to_dataframe(data_key, unit_keys=False, parse_dates=True, backend='xdr')
        except Exception as e:
            if "less than 20-bytes" in str(e) or "No data" in str(e): return pd.DataFrame()
            time.sleep(5)
    return pd.DataFrame()

def standardize_index(df):
    if df is None or df.empty: return df
    if not isinstance(df.index, pd.DatetimeIndex):
        for col in ['time', 'date', 'TIME', 'DATE']:
            if col in df.columns:
                if not pd.api.types.is_datetime64_any_dtype(df[col]): df[col] = pd.to_datetime(df[col])
                df.set_index(col, inplace=True)
                break
    if isinstance(df.index, pd.DatetimeIndex):
        if df.index.tz is not None: df.index = df.index.tz_localize(None)
        df.sort_index(inplace=True)
    return df

def get_hourly_slice_fast(df, start_t, end_t):
    if df is None or df.empty: return pd.DataFrame()
    return df.loc[start_t : end_t - timedelta(seconds=1)].copy()

def fetch_pgn_api_data(instrument, location, lat, lon, target_date, no2_col_index=38):
    BASE_URL = "https://api.pandonia-global-network.org/v1"
    start_str, end_str = target_date.strftime("%Y-%m-%dT00:00:00"), target_date.strftime("%Y-%m-%dT23:59:59")
    params = {"pan_id": instrument, "spectrometer": "1", "location": location, "code": "rnvs3", "start_datetime": start_str, "end_datetime": end_str}
    try:
        response = pgn_session.get(f"{BASE_URL}/download/bulk_l2", params=params, timeout=15)
        response.raise_for_status() 
    except: return pd.DataFrame()
    lines = response.text.split('\n')
    data_start_idx = next((i for i, line in enumerate(lines) if line.strip().startswith('202') and len(line.split()) > 20), 0)
    if data_start_idx == 0: return pd.DataFrame()
    try: df = pd.read_csv(io.StringIO('\n'.join(lines[data_start_idx:])), sep=r'\s+', header=None, on_bad_lines='skip')
    except: return pd.DataFrame()
    if df.empty or len(df.columns) <= no2_col_index: return pd.DataFrame()
    
    formatted_df = pd.DataFrame()
    formatted_df['time'] = pd.to_datetime(df[0], errors='coerce', format='mixed')
    formatted_df['STATION'] = f"{location} (Pan {instrument})"
    formatted_df['lat'], formatted_df['lon'] = lat, lon
    formatted_df['nitrogen_dioxide_vertical_column_amount'] = pd.to_numeric(df[no2_col_index], errors='coerce') * 6.0221408e19
    formatted_df.set_index('time', inplace=True)
    return formatted_df[formatted_df['nitrogen_dioxide_vertical_column_amount'] > 0]

def fetch_pgn_wrapper(args): return fetch_pgn_api_data(*args)

